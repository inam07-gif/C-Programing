#include<stdio.h>

int main(){
    int arr[5]={1,2,3,4,5};
int key=2;
int index=-1;
int length=sizeof(arr)/sizeof(int);
for(int i =0;i<sizeof(arr)/sizeof(int);i++){
    if(arr[i]==key){
        index=i;
    }

}
if(index==-1){
    printf("Element not here");

}
else{
for(int i=index;i<length-1;i++){
    arr[i]=arr[i+1];
}
length--;
for(int i=0;i<length;i++){
    printf("%d\n",arr[i]);
}
}
}

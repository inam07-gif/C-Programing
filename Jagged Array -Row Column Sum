#include <stdio.h>
#include <stdlib.h>
int **p;
void col_sum(int **arr, int max,int r,int *length){
    for(int i=0;i<max;i++){
        int sum=0;
        for(int j=0;j<r;j++){
            if(i<*(length+j)){
                sum+=*(*(arr+j)+i);
            }
        }
        printf("THE SUM OF COLUMN %d = %d ",i,sum);
    }
}
void col_go(int **arr, int *length,int r){
    
    int max_length=length[0];

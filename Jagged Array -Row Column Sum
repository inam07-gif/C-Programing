 void sum_rows(int *arr, int length, int n)
{
    int sum = 0;

    for (int j = 0; j < length; j++)
    {
        sum += *(arr + j);
    }

    printf("The sum of row %d: %d\n", n, sum);
}
int main()
{
    int rows = 3;
    int row_length[] = {1, 4, 2};
    p = calloc(rows, sizeof(int *));

    for (int i = 0; i < rows; i++)
    {
        p[i] = calloc(row_length[i], sizeof(int));
    }

    for (int i = 0; i < rows; i++)
    {
        for (int j = 0; j < row_length[i]; j++)
        {

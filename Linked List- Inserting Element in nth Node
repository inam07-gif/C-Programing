#include <stdio.h>
#include <stdlib.h>

struct class
{
    int value;
    struct class *add;
};

int main()
{

    struct class *head = 0;
    struct class *newnode;
    struct class *temp;
    int n;
    struct class *last;
    printf("ENTER NUMBER OF ELEMENTS: ");
    scanf("%d", &n);
    for (int i = 0; i < n; i++)
    {
        newnode = malloc(sizeof(struct class));
        printf("ENTER %d Element: ", i + 1);
        scanf("%d", &newnode->value);
        newnode->add = NULL;

        if (head == 0)
        {
            head = newnode;
        }
        else
        {
            temp = head;

            while (temp->add != NULL)
            {
                temp = temp->add;
            }
            temp->add = newnode;
        }
    }

    temp = head;

    printf("AT WHICH NODE INSERTION IS NEEDED(index): ");
    int index;
    scanf("%d", &index);
    int sum = 1;
    int new_value;
    if (index < 0)
    {
        printf("NOT Possible\n");
    }
    else if (index == 0)
    {
        newnode = malloc(sizeof(struct class));
        printf("ENTER NEW VALUE: ");
        scanf("%d", &new_value);
        newnode->value = new_value;
        newnode->add = temp;

        head = newnode;
    }
    else if (index > 0 && index < n)
    {
        while (temp->add != NULL && sum < index)
        {
            temp = temp->add;
            sum++;
        }

        if (temp != NULL)
        {
            newnode = malloc(sizeof(struct class));
            printf("ENTER NEW VALUE: ");
            scanf("%d", &new_value);
            newnode->value = new_value;
            newnode->add = temp->add;
            temp->add = newnode;
        }
    }
    else
    {
        printf("YOU HAVE ENTERED INDEX MORE THAN SIZE IT WILL SIT IN THE END");
        while(temp->add!=NULL){
            temp=temp->add;
        }
            newnode = malloc(sizeof(struct class));
            printf("\nENTER NEW VALUE: \n");
            scanf("%d", &new_value);
            newnode->value=new_value;
            newnode->add=NULL;
            temp->add=newnode;

    }
    temp = head;

    while (temp != NULL)
    {
        printf("%d\t", temp->value);

        temp = temp->add;
    }
}

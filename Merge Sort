int *p;
int n;
printf("ENTER THE SIZE OF ARRAY: ");
scanf("%d",&n);

p=calloc(n,sizeof(int));
for(int i=0;i<n;i++){

printf("ENTER %d element: ",i+1);
scanf("%d",&p[i]);

}
int low=0;
int high=n-1;
mergesort(p,low,high);
for(int x = 0; x < n; x++)
{
    printf("%d\t",p[x]);
}
}

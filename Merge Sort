#include<stdio.h>
#include<stdlib.h>

int merge(int *p,int l,int mid, int h){
int i = l;       // points to left half
int j = mid + 1; // points to right half
int k = 0;       // points to temporary array

int temp[h-l+1];
while(i <= mid && j <= h){
   if(p[i]<p[j]){
      temp[k]=p[i];
   k++;
   i++;
   }
   else{
      temp[k]=p[j];
      j++;
      k++;
   }

}

while(i <= mid)
{
    temp[k] = p[i];
    i++;
    k++;
}
while(j <= h)
{
    temp[k] = p[j];
    j++;
    k++;
}
for(int x = 0; x < k; x++)
{
    p[l + x] = temp[x];
}
}

void mergesort(int *p,int l, int h){
if(l<h){
   int mid = l + (h - l) / 2;
   mergesort(p,l,mid);
   mergesort(p,mid+1,h);
   merge(p,l,mid,h);
}
 
}


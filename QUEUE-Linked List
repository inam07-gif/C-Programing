void deq(struct node **f, struct node **r)
{
    if ((*f) == NULL && (*r) == NULL)
    {

        printf("EMPTYYYYYY HAI Karna kya chahta hai??");
    }

    else if ((*f) == (*r))
    {
        free((*f));
        (*f) = NULL;

        (*r) = NULL;
    }
    else
    {
        struct node *temp;
        temp = (*f);

        (*f) = (*f)->next;
        free(temp);
        temp = NULL;
    }
}

void print(struct node *f)
{

    while (f != NULL)
    {
        printf("%d\t", f->val);
        f = f->next;
    }
}

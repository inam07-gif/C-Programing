    newnode = malloc(sizeof(struct node));

    if (newnode == NULL)
    {
        printf("ALLOCATION FAILED!\n");
        return;
    }
    else
    {
        int n;

        printf("ENTer a element ");
        scanf("%d", &n);
        newnode->val = n;

        newnode->next = NULL;

        if ((*f) == NULL && (*r) == NULL)
        {

            (*f) = newnode;
            (*r) = newnode;
        }
        else
        {
            (*r)->next = newnode;
            (*r) = newnode;
        }
    }

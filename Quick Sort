#include <stdio.h>

int part(int *p, int l, int h)
{
    int pivot = p[h];
    int i = l - 1;
    for (int j = l; j < h; j++)
    {
        if (p[j] < pivot)
        {
            i++;
            int temp = p[i];
            p[i] = p[j];
            p[j] = temp;
        }
    }

    int temp = p[i + 1];
    p[i + 1] = p[h];
    p[h] = temp;

    return i + 1;
}
void quick(int *p, int low, int high)
{
    if (low<high)
    {
        int pi = part(p, low, high);
        quick(p, low, pi - 1);
        quick(p, pi + 1, high);
    }
}
int main()
{
    int arr[] = {5, 6, 3, 2, 4, 6, 9,-1};
    int n = sizeof(arr) / sizeof(int);

    quick(arr, 0, n - 1);

    for (int i = 0; i < n; i++)
    {
        printf("%d ", arr[i]);
    }
}
